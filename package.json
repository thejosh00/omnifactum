{
  "name": "omnifactum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A GTD task manager whose data is plain markdown files",
  "bin": {
    "omni": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun test",
    "test:unit": "bun test tests/unit",
    "test:watch": "bun test --watch",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/omni"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
